{
  // Checagem de tipos da suíte de produção: npm run typecheck:e2e-producao
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["./**/*.ts", "./**/*.d.mts", "../playwright.producao.config.ts"],
  "exclude": ["./playwright-report", "./test-results", "./resultados", "./.auth"]
}
