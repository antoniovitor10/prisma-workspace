# Gere os segredos com scripts/setup-docker.ps1 ou scripts/setup-docker.sh.
MSSQL_SA_PASSWORD=
PRISMA_JWT_KEY=
PRISMA_SETUP_ENABLED=true
# Segredo base64url de 32 bytes. O script gera este valor; nunca o versione.
PRISMA_SETUP_TOKEN=

# SQL Server Developer é gratuito apenas para desenvolvimento e testes.
MSSQL_PID=Developer
PRISMA_DB_NAME=PrismaWorkspace
PRISMA_HTTP_PORT=8080
